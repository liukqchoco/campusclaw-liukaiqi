# 对外入口
WEB_PORT=8080

# MySQL 初始化；请在本地 .env 中替换占位值
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=replace-with-local-app-password

# API 与服务端会话
API_PORT=8081
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=24
JWT_SECRET=replace-with-a-different-32-character-secret
JWT_TTL_MINUTES=60
COOKIE_SECURE=false

# 上传限制
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=1048576

# 预置账号口令
SEED_TEACHER_PASSWORD=replace-teacher-password
SEED_STUDENT_PASSWORD=replace-student-password

# 登录失败限流
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# OpenAI 兼容课程网关；真实值只写在本机 .env
LLM_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
LLM_API_KEY=replace-with-course-gateway-key
LLM_MODEL=course-chat
LLM_TIMEOUT_SECONDS=90

# 课程网关向量接口；EMBEDDING_DIM 只用于校验响应，不会作为请求参数发送
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
EMBEDDING_API_KEY=replace-with-course-gateway-key
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048

# 第 4 课向量库与混合检索
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw_chunks
VECTOR_SCORE_THRESHOLD=0.35
RRF_K=60

# 同仓 MCP 工具服务鉴权令牌；请替换为独立随机值
MCP_AUTH_TOKEN=replace-with-an-independent-mcp-token
