# 对外入口
WEB_PORT=8080

# MySQL 初始化；请在本地 .env 中替换占位值
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=replace-with-local-app-password

# API 与服务端会话
API_PORT=8081
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# 上传限制
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=1048576

# 预置账号口令
SEED_TEACHER_PASSWORD=replace-teacher-password
SEED_STUDENT_PASSWORD=replace-student-password

# 登录失败限流
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10
